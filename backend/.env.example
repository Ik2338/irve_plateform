# ── Database ──────────────────────────────
# In your backend/.env, change this line:
DATABASE_URL=postgresql://irve_user:irve_secret@localhost:5432/irve_db
# ── Redis ─────────────────────────────────
REDIS_URL=redis://:irve_redis_secret@redis:6379

# ── JWT ───────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Email (Resend ou SMTP) ─────────────────
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASS=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@votredomaine.fr

# ── Upload ────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=10

# ── API Adresse (gouv.fr) — pas de clé requise
ADRESSE_API_URL=https://api-adresse.data.gouv.fr
