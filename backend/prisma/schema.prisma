generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                       String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                    String                @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?
  role                     UserRole              @default(CLIENT)
  emailVerified            Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  emailVerificationExpires DateTime?
  emailVerificationToken   String?               @unique
  passwordResetExpires     DateTime?
  passwordResetToken       String?               @unique
  requests                 InstallationRequest[]
  installer                Installer?
  leads                    Lead[]
  sentQuotes               Quote[]               @relation("InstallerQuotes")
  reviews                  Review[]              // ← ajouté
  clientConversations      Conversation[]        @relation("ClientConversations")
  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]             @relation("MessageSender")
  receivedNotifications    Notification[]        @relation("NotificationRecipient")
  triggeredNotifications   Notification[]        @relation("NotificationActor")

  @@map("users")
}

model Installer {
  id                   String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String                    @unique @db.Uuid
  companyName          String
  siret                String                    @unique
  description          String?
  website              String?
  logoUrl              String?
  address              String?
  city                 String                    @default("")
  postalCode           String                    @default("")
  location             Unsupported("geography")?
  interventionRadius   Int                       @default(30)
  isVerified           Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  averageRating        Float?
  totalReviews         Int                       @default(0)
  qualifelecCertNumber String?
  qualifelecIndices    String[]                  @default([])
  qualifelecExpiresAt  DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  certifications       InstallerCertification[]
  projectTypes         InstallerProjectType[]
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads                Lead[]
  quotes               Quote[]
  reviews              Review[]
  conversations        Conversation[]

  @@map("installers")
}

model InstallerCertification {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String             @db.Uuid
  level       CertificationLevel
  certNumber  String
  issuedAt    DateTime
  expiresAt   DateTime
  documentUrl String?
  isVerified  Boolean            @default(false)
  installer   Installer          @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([installerId, level])
  @@map("installer_certifications")
}

model InstallerProjectType {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String      @db.Uuid
  projectType ProjectType
  installer   Installer   @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([installerId, projectType])
  @@map("installer_project_types")
}

model InstallationRequest {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String                    @db.Uuid
  projectType       ProjectType
  powerLevel        PowerLevel
  quantity          Int                       @default(1)
  address           String
  city              String
  postalCode        String
  location          Unsupported("geography")?
  description       String?
  hasExistingPanel  Boolean                   @default(false)
  parkingType       String?
  urgency           String?
  status            RequestStatus             @default(DRAFT)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  connectors        String[]                  @default([])
  parkingAccess     String?
  parkingSpots      Int?
  installerNote     String?
  isTargeted        Boolean                   @default(false)
  respondedAt       DateTime?
  targetInstallerId String?                   @db.Uuid
  source            String                    @default("ZONE")
  contactPreference String?
  desiredInstallDate DateTime?
  indicativeBudget  Decimal?                  @db.Decimal(10, 2)
  evModel           String?
  panelDistanceMeters Decimal?                 @db.Decimal(8, 2)
  drillingCount     Int?
  structuralDrillingCount Int?
  drillingThickness String?
  reception4g       Reception4G?
  hasInternetBox    Boolean?
  internetBoxDistanceMeters Decimal?           @db.Decimal(8, 2)
  mediaAttachments  Json                       @default("[]")
  user              User                      @relation(fields: [userId], references: [id])
  quotes            Quote[]
  matches           RequestMatch[]
  reviews           Review[]                  // ← ajouté
  conversations     Conversation[]

  @@map("installation_requests")
}

model RequestMatch {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId   String              @db.Uuid
  installerId String              @db.Uuid
  distance    Float
  score       Float
  notifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  request     InstallationRequest @relation(fields: [requestId], references: [id])

  @@map("request_matches")
}

model Quote {
  id           String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId    String              @db.Uuid
  installerId  String              @db.Uuid
  userId       String              @db.Uuid
  amount       Float
  laborCost    Float
  notes        String?
  validUntil   DateTime
  pdfUrl       String?
  status       QuoteStatus         @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  installer    Installer           @relation(fields: [installerId], references: [id])
  request      InstallationRequest @relation(fields: [requestId], references: [id])
  sentBy       User                @relation("InstallerQuotes", fields: [userId], references: [id])
  conversations Conversation[]

  @@map("quotes")
}

model Review {
  id          String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String               @db.Uuid
  requestId   String?              @db.Uuid  // ← ajouté (optionnel pour compatibilité)
  clientId    String?              @db.Uuid  // ← ajouté (optionnel pour compatibilité)
  rating      Int
  comment     String?
  createdAt   DateTime             @default(now())
  installer   Installer            @relation(fields: [installerId], references: [id])
  request     InstallationRequest? @relation(fields: [requestId], references: [id])  // ← ajouté
  client      User?                @relation(fields: [clientId], references: [id])   // ← ajouté

  @@map("reviews")
}

model Lead {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String     @db.Uuid
  clientId    String     @db.Uuid
  address     String
  message     String
  status      LeadStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      User       @relation(fields: [clientId], references: [id])
  installer   Installer  @relation(fields: [installerId], references: [id])
  conversations Conversation[]

  @@map("leads")
}

model Conversation {
  id            String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clientId      String                    @db.Uuid
  installerId   String                    @db.Uuid
  requestId     String?                   @db.Uuid
  leadId        String?                   @db.Uuid
  quoteId       String?                   @db.Uuid
  context       ConversationContext       @default(PRE_REQUEST)
  status        ConversationStatus        @default(ACTIVE)
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  client        User                      @relation("ClientConversations", fields: [clientId], references: [id])
  installer     Installer                 @relation(fields: [installerId], references: [id])
  request       InstallationRequest?      @relation(fields: [requestId], references: [id])
  lead          Lead?                     @relation(fields: [leadId], references: [id])
  quote         Quote?                    @relation(fields: [quoteId], references: [id])
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([clientId])
  @@index([installerId])
  @@index([requestId])
  @@index([leadId])
  @@index([quoteId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  body           String
  attachments    Json         @default("[]")
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String           @db.Uuid
  actorId   String?          @db.Uuid
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  CLIENT
  INSTALLER
  ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  MATCHED
  QUOTE_SENT
  QUOTE_ACCEPTED
  INSTALLATION     
  MISE_EN_SERVICE  
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  COPROPRIETE
  HOTEL
  SYNDIC
}

enum PowerLevel {
  P1
  P2
  P3
  P4
  P5
}

enum CertificationLevel {
  IRVE_P1
  IRVE_P2
  IRVE_P3
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

enum LeadStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ConversationContext {
  PRE_REQUEST
  LEAD
  QUOTE
  PROJECT
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum NotificationType {
  NEW_MESSAGE
  NEW_QUOTE
  QUOTE_ACCEPTED
  NEW_REQUEST
  REQUEST_RESPONSE
}

enum Reception4G {
  BONNE
  MOYENNE
  MEDIOCRE
  AUCUNE
}
