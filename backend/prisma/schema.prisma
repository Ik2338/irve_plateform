generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
  id                       String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                    String                @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?
  role                     UserRole              @default(CLIENT)
  emailVerified            Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  emailVerificationExpires DateTime?
  emailVerificationToken   String?               @unique
  passwordResetExpires     DateTime?
  passwordResetToken       String?               @unique
  requests                 InstallationRequest[]
  installer                Installer?
  leads                    Lead[]
  sentQuotes               Quote[]               @relation("InstallerQuotes")
  reviews                  Review[]              // ← ajouté

  @@map("users")
}

model Installer {
  id                   String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String                    @unique @db.Uuid
  companyName          String
  siret                String                    @unique
  description          String?
  website              String?
  logoUrl              String?
  address              String?
  city                 String                    @default("")
  postalCode           String                    @default("")
  location             Unsupported("geography")?
  interventionRadius   Int                       @default(30)
  isVerified           Boolean                   @default(false)
  isActive             Boolean                   @default(true)
  averageRating        Float?
  totalReviews         Int                       @default(0)
  qualifelecCertNumber String?
  qualifelecIndices    String[]                  @default([])
  qualifelecExpiresAt  DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  certifications       InstallerCertification[]
  projectTypes         InstallerProjectType[]
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads                Lead[]
  quotes               Quote[]
  reviews              Review[]

  @@map("installers")
}

model InstallerCertification {
  id          String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String             @db.Uuid
  level       CertificationLevel
  certNumber  String
  issuedAt    DateTime
  expiresAt   DateTime
  documentUrl String?
  isVerified  Boolean            @default(false)
  installer   Installer          @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([installerId, level])
  @@map("installer_certifications")
}

model InstallerProjectType {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String      @db.Uuid
  projectType ProjectType
  installer   Installer   @relation(fields: [installerId], references: [id], onDelete: Cascade)

  @@unique([installerId, projectType])
  @@map("installer_project_types")
}

model InstallationRequest {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String                    @db.Uuid
  projectType       ProjectType
  powerLevel        PowerLevel
  quantity          Int                       @default(1)
  address           String
  city              String
  postalCode        String
  location          Unsupported("geography")?
  description       String?
  hasExistingPanel  Boolean                   @default(false)
  parkingType       String?
  urgency           String?
  status            RequestStatus             @default(DRAFT)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  connectors        String[]                  @default([])
  parkingAccess     String?
  parkingSpots      Int?
  installerNote     String?
  isTargeted        Boolean                   @default(false)
  respondedAt       DateTime?
  targetInstallerId String?                   @db.Uuid
  source            String                    @default("ZONE")
  user              User                      @relation(fields: [userId], references: [id])
  quotes            Quote[]
  matches           RequestMatch[]
  reviews           Review[]                  // ← ajouté

  @@map("installation_requests")
}

model RequestMatch {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId   String              @db.Uuid
  installerId String              @db.Uuid
  distance    Float
  score       Float
  notifiedAt  DateTime?
  createdAt   DateTime            @default(now())
  request     InstallationRequest @relation(fields: [requestId], references: [id])

  @@map("request_matches")
}

model Quote {
  id           String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId    String              @db.Uuid
  installerId  String              @db.Uuid
  userId       String              @db.Uuid
  amount       Float
  vatRate      Float               @default(20)
  laborCost    Float
  materialCost Float
  notes        String?
  validUntil   DateTime
  pdfUrl       String?
  status       QuoteStatus         @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  installer    Installer           @relation(fields: [installerId], references: [id])
  request      InstallationRequest @relation(fields: [requestId], references: [id])
  sentBy       User                @relation("InstallerQuotes", fields: [userId], references: [id])

  @@map("quotes")
}

model Review {
  id          String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String               @db.Uuid
  requestId   String?              @db.Uuid  // ← ajouté (optionnel pour compatibilité)
  clientId    String?              @db.Uuid  // ← ajouté (optionnel pour compatibilité)
  rating      Int
  comment     String?
  createdAt   DateTime             @default(now())
  installer   Installer            @relation(fields: [installerId], references: [id])
  request     InstallationRequest? @relation(fields: [requestId], references: [id])  // ← ajouté
  client      User?                @relation(fields: [clientId], references: [id])   // ← ajouté

  @@map("reviews")
}

model Lead {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  installerId String     @db.Uuid
  clientId    String     @db.Uuid
  address     String
  message     String
  status      LeadStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      User       @relation(fields: [clientId], references: [id])
  installer   Installer  @relation(fields: [installerId], references: [id])

  @@map("leads")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum UserRole {
  CLIENT
  INSTALLER
  ADMIN
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  MATCHED
  QUOTE_SENT
  QUOTE_ACCEPTED
  INSTALLATION     // ← ajouté : installateur a démarré
  MISE_EN_SERVICE  // ← ajouté : installateur a terminé, attend confirmation client
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  COPROPRIETE
  HOTEL
  SYNDIC
}

enum PowerLevel {
  P1
  P2
  P3
  P4
  P5
}

enum CertificationLevel {
  IRVE_P1
  IRVE_P2
  IRVE_P3
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

enum LeadStatus {
  PENDING
  ACCEPTED
  REJECTED
}
